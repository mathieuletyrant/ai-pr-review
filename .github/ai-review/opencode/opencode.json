{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "small_model": "openrouter/deepseek/deepseek-v4.1-flash",
  "provider": {
    "openrouter": {
      "options": {
        "extraBody": {
          "provider": {
            "only": ["fireworks", "together", "baseten", "deepinfra", "coreweave", "parasail"],
            "data_collection": "deny",
            "zdr": true,
            "require_parameters": true,
            "allow_fallbacks": true,
            "sort": "throughput"
          }
        }
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "tool_call": true,
          "options": { "reasoning": { "enabled": false } }
        },
        "z-ai/glm-5.3-flash": {
          "tool_call": true
        },
        "z-ai/glm-5.3": {
          "tool_call": true
        }
      }
    }
  }
}
